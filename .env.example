# Copie para .env.local e preencha. Nunca envie valores reais ao GitHub.
# SUPABASE_SERVICE_ROLE_KEY é secreta e server-only: nunca use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE
SUPABASE_SCHEMA=ml_dashboards
SUPABASE_ACCOUNT_NAME=PC Express

# Opcionais
# RETURNS_DEMO_MODE=true   # true: devoluções fictícias no computador local; false: desliga em qualquer ambiente
# LOGISTICS_V2_ENABLED=false
